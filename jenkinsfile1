pipeline {
    agent any

    options {
        timestamps()
    }

    stages {
        stage('Build') {
            steps {
                 echo 'Vérification des fichiers...'              
                 bat 'if not exist index.html exit /b 1'
                 bat 'if not exist style.css exit /b 1'
            }
        }

        stage('Test') {
            steps {
                echo 'Vérification du fichier HTML'
                bat 'findstr /c:"<html" index.html'
                bat 'findstr /c:"<h1>" index.html'
            }
        }

        stage('Delivery') {
            steps {
                echo 'Archivage du Site Web'
                // archiveArtifacts artifacts: 'index.html, style.css', allowableEmptyArchive: false
            }
        }
    } 

    post {
        success {
            echo 'Build Succès'
        }
        failure {
            echo 'Build Échec'
        }
    }
} // Fin du bloc pipeline (qui manquait)
